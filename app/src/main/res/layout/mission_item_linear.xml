<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/item_bkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@color/bluegray">

        <FrameLayout
            android:id="@+id/item_thumbnail_container"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="128dp"
                android:layout_height="72dp"
                android:background="@drawable/download_thumbnail_background"
                android:contentDescription="@string/download_thumbnail_description"
                android:padding="18dp"
                android:scaleType="fitCenter"
                app:tint="?attr/actionColor" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="#CC000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/item_thumbnail_container"
            android:layout_toStartOf="@id/item_more"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_toEndOf="@id/item_thumbnail_container"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_name"
            android:layout_alignParentEnd="true"
            android:layout_toStartOf="@id/item_more"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_size"
            android:layout_toEndOf="@id/item_thumbnail_container"
            android:layout_toStartOf="@id/item_more"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/item_more"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/more_options"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/actionColor" />
    </RelativeLayout>
</RelativeLayout>
