<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+: the system splash is only a red background, the animation is in SplashActivity -->
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ymn_splash_background</item>
        <item name="android:statusBarColor">@color/ymn_splash_background</item>
        <item name="android:navigationBarColor">@color/ymn_splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/ymn_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

</resources>
